# --- Godot 4 ---
# Cache do editor. NUNCA commite: e gerado localmente e e a fonte numero 1
# de conflito bobo em time.
.godot/
/android/

# Builds locais
/builds/
/build/
*.exe
*.pck
*.zip

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/
.idea/
*.swp
*~

# Godot deixa isso para tras as vezes
*.translation

# Config de MCP: o caminho do servidor e por maquina, nao vale versionar.
.mcp.json

# Grafo de conhecimento (graphify)
# Saida gerada a partir do proprio codigo: da para refazer a qualquer momento.
# Sao ~1,8 MB de JSON/HTML que mudam inteiros a cada rodagem, e os arquivos de
# controle guardam caminho absoluto da maquina de quem rodou -- inuteis e
# conflitantes para o resto do time.
graphify-out/

# Config local do Claude Code: e por maquina, como o .mcp.json acima.
.claude/settings.local.json

# Builds geradas pelo CI de release.
/builds/

# Referencias de arte de terceiros (concept art, mood boards). Ficam na maquina
# de quem coletou: sao material de consulta, nao do jogo, e nao ha licenca para
# redistribuir junto de uma build publica.
inspiração/

# Material bruto de animacao. Os GIFs sao a ENTRADA de
# tools/sprites/gerar_sprites.py, e o Godot nem sequer importa GIF -- o que o
# jogo usa sao as fitas PNG normalizadas em assets/personagens/. Versionar os
# dois seria guardar a mesma arte duas vezes, e a copia grande e a que ninguem
# le. Quem for regerar precisa dos GIFs; quem so vai jogar, nao.
animations/

# Hooks do git-lfs que foram parar num caminho literal `dev/null` num shell do
# Windows -- `> /dev/null` cria o diretorio em vez de descartar. Nao sao do
# projeto e nao devem voltar.
dev/
