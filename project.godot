[layer_names]

2d_render/layer_1="mundo"
2d_physics/layer_1="player"
2d_physics/layer_2="inimigo"
2d_physics/layer_3="parede"
2d_physics/layer_4="projetil_player"
2d_physics/layer_5="projetil_inimigo"
2d_physics/layer_6="pickup"

[physics]

2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043137, 0.047059, 0.078431, 1)
